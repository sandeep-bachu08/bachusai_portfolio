# ==============================================================================
# BACHU VENKATA SAI SANDEEP — PORTFOLIO ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. Application URL & Environment
APP_URL="MY_APP_URL"
ENVIRONMENT="development"

# 2. Frontend API Base URL
# Leave empty when proxying /api locally or on same origin, or set to your
# Vercel FastAPI backend URL (e.g. https://sandeep-portfolio-backend.vercel.app)
VITE_API_BASE_URL=""

# 3. Optional SMTP Email Delivery for Contact Form
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
CONTACT_RECIPIENT_EMAIL="bachusaisandeep@gmail.com"

# 4. Rate Limiting & CORS
ALLOWED_ORIGINS="*"
RATE_LIMIT_MAX_REQUESTS="10"
RATE_LIMIT_WINDOW_SECONDS="60"
